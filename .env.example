# Redis connection
REDIS_URL=redis://redis:6379

# MongoDB connection
MONGODB_URI=mongodb://mongo:27017

# MySQL connection
DATABASE_URL=mysql://nilsbohr:${MYSQL_PASSWORD}@mysql:3306/nilsbohr

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_client_id_here
GITHUB_CLIENT_SECRET=your_client_secret_here

# Google OAuth App (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# JWT signing key (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# Where to redirect after login (must match OAuth redirect URIs)
FRONTEND_URL=http://localhost

# Backend port
PORT=5000

# MySQL root and user passwords
MYSQL_ROOT_PASSWORD=root_password_here
MYSQL_PASSWORD=user_password_here

# Frontend env (used at build time)
VITE_BACKEND_URL=http://localhost
